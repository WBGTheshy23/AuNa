{
    "editor.formatOnSave": true,
    "cmake.ignoreCMakeListsMissing": true,
    "clangd.path": "/usr/bin/clangd",
    "editor.fontSize": 16,
    // set python interpreter
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "editor.formatOnSave": true,
    },
    "files.associations": {
        "array": "cpp",
        "string_view": "cpp",
        "initializer_list": "cpp",
        "utility": "cpp",
        "vector": "cpp"
    }
}